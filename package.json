{
  "name": "orbit-lab",
  "version": "1.1.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Interactive ideal Kepler orbit experiments with shared time scale and curved equal-area sectors",
  "main": "desktop/main.cjs",
  "author": "Orbit Lab",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5250 --strictPort",
    "build": "vite build",
    "test": "node --test tests/model.test.mjs tests/geometry.test.mjs tests/project.test.mjs tests/atomic-save.test.mjs tests/lessons.test.mjs tests/detail-model.test.mjs tests/scene-detail.test.mjs",
    "desktop": "node scripts/desktop.mjs start",
    "package:desktop": "node scripts/desktop.mjs package",
    "test:browser": "node tests/browser.test.mjs",
    "test:desktop": "node tests/desktop.test.mjs",
    "test:consumer": "node tests/consumer.test.mjs",
    "test:consumer-acceptance": "node tests/consumer-acceptance.test.mjs",
    "test:detail": "node tests/detail-browser.test.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "7.3.6"
  }
}
